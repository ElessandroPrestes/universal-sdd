#!/bin/sh

message_file=$1

if [ ! -r "$message_file" ]; then
  echo "commit-msg: cannot read commit message file." >&2
  exit 1
fi

spec_pattern='^Spec-Ref: SPEC-[0-9][0-9][0-9](-v[0-9][0-9]*)?$'
task_pattern='^Task-Ref: TASK-[0-9][0-9][0-9]-[0-9][0-9]$'
has_spec=$(grep -Ec '^Spec-Ref:' "$message_file")
has_task=$(grep -Ec '^Task-Ref:' "$message_file")

if [ "$has_spec" -eq 0 ] && [ "$has_task" -eq 0 ]; then
  exit 0
fi

if [ "$has_spec" -ne 1 ] || [ "$has_task" -ne 1 ]; then
  echo "commit-msg: include exactly one Spec-Ref and one Task-Ref trailer together." >&2
  exit 1
fi

if ! grep -Eq "$spec_pattern" "$message_file"; then
  echo "commit-msg: Spec-Ref must use SPEC-NNN or SPEC-NNN-vN." >&2
  exit 1
fi

if ! grep -Eq "$task_pattern" "$message_file"; then
  echo "commit-msg: Task-Ref must use TASK-NNN-XX." >&2
  exit 1
fi
